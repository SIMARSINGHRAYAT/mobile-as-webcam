{
  "name": "nextjs-postgresql-template",
  "version": "1.0.0",
  "description": "Mobile as Webcam Desktop Application",
  "author": "Development",
  "private": true,
  "main": "main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "electron:dev": "cross-env NODE_ENV=development electron .",
    "electron:build": "node build-app.js"
  },
  "build": {
    "appId": "com.mobileaswebcam.app",
    "productName": "MOBILE as WEBCAM",
    "directories": {
      "output": "dist6"
    },
    "files": [
      "main.js",
      "preload.js",
      "package.json",
      ".next/standalone/**/*",
      ".next/static/**/*",
      "public/**/*"
    ],
    "asar": false,
    "win": {
      "target": "appx",
      "icon": "build/icon.png"
    },
    "appx": {
      "identityName": "MobileAsWebcam",
      "publisher": "CN=Development",
      "publisherDisplayName": "Development"
    }
  },
  "dependencies": {
    "@types/qrcode": "^1.5.6",
    "dotenv": "17.3.1",
    "drizzle-orm": "0.45.2",
    "lucide-react": "^1.34.0",
    "next": "16.2.6",
    "pg": "8.20.0",
    "qrcode.react": "^4.2.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.17",
    "@types/node": "22.19.15",
    "@types/pg": "8.18.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "cross-env": "^10.1.0",
    "drizzle-kit": "0.31.10",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "postcss": "8.5.8",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "wait-on": "^9.1.0"
  }
}
